.hours strong { color: var(--muted); font-size: 10px; font-weight: 400; }

.hours p { margin-top: 15px; font-size: 9px; }

form { border: 1px solid var(--line); border-radius: 10px; padding: 30px; box-shadow: rgba(24, 61, 60, 0.02) 0px 8px 30px; }

form > h3 { letter-spacing: -0.6px; font-size: 21px; }

form > p { margin-top: 6px; font-size: 11px; }

fieldset { border: 0px; min-width: 0px; margin: 22px 0px 0px; padding: 0px; }

.form-row { grid-template-columns: 1fr 1fr; gap: 15px; display: grid; }

label { margin-bottom: 17px; font-size: 10px; font-weight: 550; display: block; }

input, textarea { width: 100%; color: var(--navy); background: rgb(255, 255, 255); border: 1px solid rgb(220, 229, 226); border-radius: 5px; min-width: 0px; margin-top: 8px; padding: 12px; font-size: 11px; display: block; }

