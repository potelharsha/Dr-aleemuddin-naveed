  .services { gap: 45px; }
  .appointment-grid { gap: 55px; }
  .care-item { gap: 9px; padding-left: 18px; }
  .care-item strong { font-size: 10px; }
  .care-item span { font-size: 9px; }
  .footer-grid { gap: 28px; }
  .location-grid { gap: 40px; }
  .location-buttons { gap: 12px; }
}

@media (width <= 900px) {
