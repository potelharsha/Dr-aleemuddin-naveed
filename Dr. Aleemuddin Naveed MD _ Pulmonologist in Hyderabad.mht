textarea { resize: vertical; }

.optional { color: var(--muted); font-weight: 400; }

.form-privacy { margin-bottom: 17px; font-size: 9px; line-height: 1.7; }

.form-privacy button { color: var(--teal); background: 0px 0px; border: 0px; padding: 0px; text-decoration: underline; }

.submit { justify-content: space-between; width: 100%; }

.form-disclaimer { justify-content: center; align-items: flex-start; gap: 5px; line-height: 1.5; display: flex; margin-top: 13px !important; font-size: 8px !important; }

.success, .error { color: rgb(36, 107, 80); background: rgb(232, 245, 239); border-radius: 5px; padding: 12px; margin-top: 15px !important; font-size: 12px !important; }

