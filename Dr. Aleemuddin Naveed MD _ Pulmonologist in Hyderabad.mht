.location-section { background: rgb(242, 246, 245); padding: 64px 0px; }

.location-grid { grid-template-columns: 1fr 1.1fr; align-items: center; gap: 70px; display: grid; }

.location-section h2 { font-size: 32px; }

.location-address { align-items: flex-start; gap: 12px; margin-top: 25px; display: flex; }

.location-address > svg { color: var(--teal); margin-top: 2px; }

.location-address h3 { margin-bottom: 7px; font-size: 13px; }

.location-address p { max-width: 340px; margin-top: 5px; font-size: 11px; }

.clinic-tag { color: var(--teal); border: 1px solid rgb(191, 215, 206); border-radius: 3px; padding: 2px 7px; font-size: 8px; }

.location-buttons { align-items: center; gap: 18px; margin-top: 22px; display: flex; }

.location-buttons .button { padding: 13px 16px; font-size: 10px; }

.location-buttons .text-link { gap: 5px; font-size: 10px; }

.map-frame { background: rgb(220, 232, 226); border: 1px solid rgb(214, 225, 221); border-radius: 9px; height: 340px; position: relative; overflow: hidden; }

.map-frame iframe { filter: saturate(0.5); border: 0px; width: 100%; height: 100%; }

.map-overlay { background: rgb(255, 255, 255); border: 1px solid rgb(225, 233, 229); border-radius: 6px; align-items: center; gap: 11px; padding: 17px; font-size: 11px; font-weight: 600; display: flex; position: absolute; bottom: 18px; left: 18px; right: 18px; box-shadow: rgba(33, 56, 74, 0.063) 0px 4px 20px; }

.map-overlay > svg { color: var(--teal); }

.map-overlay > svg:last-child { margin-left: auto; }

.map-overlay small { color: var(--muted); margin-top: 5px; font-size: 9px; font-weight: 400; display: block; }

.emergency { align-items: center; gap: 14px; padding-top: 24px; padding-bottom: 24px; display: flex; }

.emergency > svg { color: rgb(173, 119, 87); }

.emergency p { color: rgb(137, 114, 96); font-size: 10px; line-height: 1.7; }

.emergency strong { color: rgb(128, 94, 72); }

footer { color: rgb(208, 221, 225); background: rgb(21, 59, 73); padding-top: 49px; }

.footer-grid { grid-template-columns: 1.55fr 0.7fr 0.9fr 1.1fr; gap: 50px; padding-bottom: 42px; display: grid; }

footer .brand { color: rgb(255, 255, 255); font-size: 15px; }

footer .brand-icon { color: rgb(166, 212, 199); }

footer .brand-sub { letter-spacing: 1.3px; font-size: 6px; }

footer p { color: rgb(167, 189, 196); margin-top: 18px; font-size: 10px; }

footer h3 { color: rgb(255, 255, 255); margin: 6px 0px 18px; font-family: "DM Sans", sans-serif; font-size: 11px; font-weight: 550; }

.footer-grid > div > a:not(.brand) { color: rgb(182, 203, 208); align-items: center; gap: 8px; margin-top: 12px; font-size: 10px; display: flex; }

.footer-grid .footer-phone { margin-top: 18px !important; }

.footer-grid .footer-appointment { color: rgb(215, 233, 223) !important; }

.footer-grid > div:last-child p { margin-top: 0px; }

.footer-bottom { color: rgb(154, 179, 189); border-top: 1px solid rgb(49, 83, 94); justify-content: space-between; align-items: center; padding-top: 20px; padding-bottom: 23px; font-size: 8px; display: flex; }

.footer-bottom > div { gap: 25px; display: flex; }

.footer-bottom button { color: rgb(182, 203, 208); background: 0px 0px; border: 0px; padding: 0px; font-size: 8px; }

.skip { z-index: 100; background: rgb(255, 255, 255); padding: 15px; position: fixed; top: -80px; left: 20px; }

.skip:focus { top: 10px; }

.modal-backdrop { backdrop-filter: blur(4px); z-index: 50; background: rgba(19, 57, 71, 0.72); place-items: center; padding: 24px; display: grid; position: fixed; inset: 0px; }

.policy-modal { background: rgb(255, 255, 255); border-radius: 12px; max-width: 620px; max-height: 85vh; padding: 38px; position: relative; overflow: auto; }

.policy-modal h2 { margin-bottom: 22px; font-size: 26px; }

.policy-modal p { margin-bottom: 18px; font-size: 13px; }

.close-modal { color: var(--navy); background: 0px 0px; border: 0px; position: absolute; top: 16px; right: 16px; }

.hero-copy { animation: 0.7s ease-out 0s 1 normal none running fade-in; }

.hero-visual { animation: 0.9s ease-out 0s 1 normal none running fade-in; }

@keyframes fade-in { 
  0% { opacity: 0; transform: translateY(16px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@media (width >= 1450px) {
  .hero { padding-top: 80px; padding-bottom: 65px; }
  .image-frame { height: 550px; }
