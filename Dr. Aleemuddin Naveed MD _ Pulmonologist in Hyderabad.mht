.image-label { backdrop-filter: blur(10px); color: var(--navy); background: rgba(255, 255, 255, 0.93); border: 1px solid rgb(255, 255, 255); border-radius: 8px; align-items: center; gap: 14px; padding: 18px 20px; font-size: 12px; line-height: 1.8; display: flex; position: absolute; bottom: 25px; left: 24px; right: 24px; }

