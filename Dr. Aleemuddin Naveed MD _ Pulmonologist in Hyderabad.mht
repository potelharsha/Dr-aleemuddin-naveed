.reviews-section { background: rgb(245, 248, 247); padding: 67px 0px 70px; }

.review-score { align-items: center; gap: 17px; display: flex; }

.review-score > span { letter-spacing: -3px; color: var(--navy); font-family: Manrope, sans-serif; font-size: 50px; font-weight: 650; }

.review-score > span small { letter-spacing: 0px; color: rgb(129, 145, 143); font-size: 20px; }

